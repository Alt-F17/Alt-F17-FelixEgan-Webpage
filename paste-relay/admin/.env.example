# Port the admin dashboard's HTTP server listens on inside the container.
# ADMIN_PORT=4120

# Shared secret required in the X-Admin-Key header for the one mutating
# route (POST /api/invites) — a gate on top of the Tailscale-only network
# perimeter. Required — an empty/unset value should fail closed, not open
# access. Generate with `openssl rand -hex 32`.
ADMIN_API_KEY=

# Hostname of the docker-socket-proxy container, reached over the
# paste_relay_internal Docker network defined in docker-compose.yml.
# DOCKER_PROXY_HOST=docker-socket-proxy

# TCP port docker-socket-proxy listens on inside the paste_relay_internal network.
# DOCKER_PROXY_PORT=2375

# Path to the shared paste-relay SQLite database file — the same
# paste_relay_data volume the paste-relay service uses, mounted read-write.
# PASTE_RELAY_DB_PATH=/var/lib/paste-relay/paste-relay.db
