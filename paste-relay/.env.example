# Comma-separated allowlist of Google account emails permitted to use the
# relay. Required — an empty/unset value makes every request fail with 500
# (fail closed), it does not open access.
ALLOWED_EMAILS=felix.egan@icloud.com

# OAuth 2.0 Web application Client ID from Google Cloud Console. Must match
# VITE_GOOGLE_OAUTH_CLIENT_ID configured in the Vercel project for the
# frontend. See docs/theta-paste-relay-plan.md for how to create it.
GOOGLE_OAUTH_CLIENT_ID=

# Origins allowed to call this API. Defaults to the production site if unset.
# ALLOWED_ORIGINS=https://felixegan.me,https://www.felixegan.me

# MAX_FILE_BYTES=5368709120
# TTL_SECONDS=300
# STORAGE_DIR=/var/lib/paste-relay
# PORT=8787
