# HMAC signing secret used to sign/verify session tokens (crypto.createHmac).
# Required — an empty/unset value makes every request fail with 500
# (fail closed), it does not open access. Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Pepper mixed into the PIN-derived content-encryption key and blob-filename
# derivation, kept separate from SESSION_SECRET for clean domain separation.
# Required — generate with `openssl rand -hex 32`.
ENCRYPTION_PEPPER=

# Cloudflare Turnstile secret key, used server-side to verify captcha tokens
# against https://challenges.cloudflare.com/turnstile/v0/siteverify.
TURNSTILE_SECRET_KEY=

# Hostname of the clamd container, reached over the paste_relay_internal
# Docker network defined in docker-compose.yml.
# CLAMD_HOST=clamav

# TCP port clamd listens on inside the paste_relay_internal network.
# CLAMD_PORT=3310

# Origins allowed to call this API. Defaults to the production site if unset.
# ALLOWED_ORIGINS=https://felixegan.me,https://www.felixegan.me

# MAX_FILE_BYTES=5368709120
# TTL_SECONDS=300
# STORAGE_DIR=/var/lib/paste-relay
# PORT=8787

# Session lifetime in seconds before a token expires and re-login is required.
# SESSION_TTL_SECONDS=86400

# Total logical storage quota across all accounts/items combined, in bytes (20GB).
# TOTAL_QUOTA_BYTES=21474836480

# Max number of concurrent active items allowed per source IP.
# MAX_ITEMS_PER_IP=3

# Consecutive wrong PIN guesses on one item before it is destroyed immediately.
# PIN_MAX_ATTEMPTS=5

# Per-IP rate limit on the paste/file creation routes, requests per minute.
# CREATE_RATE_LIMIT_PER_MIN=1

# Per-IP rate limit on the login route, requests per minute.
# LOGIN_RATE_LIMIT_PER_MIN=5

# Milliseconds an item may sit in pending_scan before the background sweep
# force-rejects it as stuck (protects the quota from a crashed scan).
# PENDING_SCAN_DEADLOCK_MS=1800000
